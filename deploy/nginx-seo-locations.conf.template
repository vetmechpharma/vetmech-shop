# Managed VETMECH SEO routes. Included INSIDE this website's HTTPS server block.
location = /robots.txt {
    proxy_pass http://127.0.0.1:@BACKEND_PORT@/api/robots.txt;
}
location = /sitemap.xml {
    proxy_pass http://127.0.0.1:@BACKEND_PORT@/api/sitemap.xml;
}

# Redirect the old singular URL used by copied canonical settings.
location ~ ^/product/([^/]+)/?$ {
    return 301 @SITE_ORIGIN@/products/$1;
}

# Only page URLs participate in crawler rendering. Static assets and other apps
# continue through their existing locations. This is a compatibility workaround
# for the existing React SPA, not a separate catalogue or an SSR framework.
location ~ ^/(?:products(?:/[^/]+)?|categories/[^/]+|news(?:/[^/]+)?|about|quality|infrastructure|research|gallery|careers|contact|privacy|terms|shop(?:/.*)?|account|register|cart|checkout|quick-order|order-confirmed(?:/.*)?)?/?$ {
    root "@FRONTEND_ROOT@";
    expires -1;
    error_page 418 = @vetmech_seo_document;
    if ($http_user_agent ~* "googlebot|google-inspectiontool|bingbot|yandex|duckduckbot|baiduspider|facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|slackbot|telegrambot|discordbot|applebot|pinterest") {
        return 418;
    }
    try_files $uri /index.html;
}
location @vetmech_seo_document {
    rewrite ^ /api/seo/render?path=$uri break;
    proxy_pass http://127.0.0.1:@BACKEND_PORT@;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}
